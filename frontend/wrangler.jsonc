{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ai-docs-frontend",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding (revalidate paths patch). The app
			// currently uses no revalidate/ISR, but the adapter patches that
			// code path — keep the binding so it stays functional if added.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ai-docs-frontend"
		}
	],
	// Keep dashboard-owned values when Git deployment publishes a new Worker.
	// Required Production values (and Preview equivalents where applicable):
	// BACKEND_API_URL=https://api.<domain>
	// DISABLE_PUBLIC_REGISTER=false
	// TURNSTILE_SITE_KEY=<Cloudflare Turnstile site key>
	// PUBLIC_OPERATOR_NAME=DocAI
	// PUBLIC_OPERATOR_JURISDICTION=Vietnam
	// PUBLIC_SUPPORT_EMAIL=support@<domain>
	// PUBLIC_POLICY_EFFECTIVE_DATE=<actual deployment YYYY-MM-DD>
	// PASSWORD_RESET_MODE=disabled
	// SESSION_COOKIE_SECURE=true
	// FRONTEND_TRUST_PROXY_HOPS=<verified Cloudflare hop count>
	"keep_vars": true
}
