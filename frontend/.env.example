# Backend connection used by the server-side BFF.
BACKEND_API_URL="http://localhost:3001"

# Local standalone HTTP requires false. Set true for an HTTPS deployment.
SESSION_COOKIE_SECURE="false"

# Public Cloudflare Turnstile site key. Use Cloudflare's documented test key
# locally and the hostname-restricted production key in Cloud Run.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Number of reverse-proxy hops trusted when deriving the signup client address.
FRONTEND_TRUST_PROXY_HOPS="0"
