# Standalone project env — copy to .env and fill in (both .env and backend/.env are gitignored)
#
#   cp .env.example .env
#   then generate fresh secrets (see README "Quick start")

# Database
POSTGRES_DB=ai_docs
POSTGRES_USER=postgres
DB_PASSWORD=your-secure-password-here-change-in-production
# Standalone volume names — MUST NOT collide with any other stack on this host
POSTGRES_VOLUME=standalone_postgres_data
REDIS_VOLUME=standalone_redis_data

# Conversion service
CONVERSION_SERVICE_URL=http://conversion:8004
# Scanned-page vision is BYOK: each user configures their own Google Gemini
# API key in the app's settings dialog. The server holds no vision key.
