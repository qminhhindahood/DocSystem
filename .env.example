# Database
POSTGRES_DB=ai_docs
POSTGRES_USER=postgres
DB_PASSWORD=your-secure-password-here-change-in-production
# PostgreSQL volume name (set per-environment; default in docker-compose.yml)
POSTGRES_VOLUME=llm_postgres_data

# LM Studio
# LLM provider/model/API keys are configured per user in application Settings.

# Redis
REDIS_URL=redis://localhost:6379

# Docling
DOCLING_URL=http://localhost:8001

# Embeddings
EMBEDDINGS_URL=http://localhost:8002

# Conversion service (PDF -> DOCX, Direction 1)
CONVERSION_SERVICE_URL=http://localhost:8004
# Gemini Flash API key for scanned-page vision (optional; digital pages are free)
GEMINI_API_KEY=

# Local LLM provider allowlist (comma-separated host:port entries)
# Only host:port pairs in this list may point at private/RFC1918 addresses.
# Required for lmstudio/ollama when running in Docker — set to:
#   host.docker.internal:1234
LOCAL_LLM_HOST_ALLOWLIST=host.docker.internal:1234

# Private open-source DOCX renderer
# Generate a random value of at least 32 characters; backend and renderer share it.
RENDERER_INTERNAL_TOKEN=replace-with-a-random-32-character-secret
RENDERER_REQUIRED_FONTS=Liberation Serif,Liberation Sans,Carlito,Caladea,Noto Sans
RENDERER_RENDER_TIMEOUT_SECONDS=120
RENDERER_MAX_CONCURRENT_RENDERS=2
RENDERER_PNG_DPI=144
RENDERER_MAX_RENDERED_PAGES=100
RENDERER_MAX_RENDERED_BYTES=268435456

# Server
PORT=3001
NODE_ENV=development
