# Standalone project env — copy to .env and fill in (both .env and backend/.env are gitignored)
#
#   cp .env.example .env
#   then generate fresh secrets (see README "Quick start")

# Database
POSTGRES_DB=ai_docs
POSTGRES_USER=postgres
DB_PASSWORD=your-secure-password-here-change-in-production
# Standalone volume names — MUST NOT collide with any other stack on this host
POSTGRES_VOLUME=standalone_postgres_data
REDIS_VOLUME=standalone_redis_data

# Authentication
# Password recovery stays disabled until SMTP is configured in backend/.env.
PASSWORD_RESET_MODE=disabled
# Local Compose serves HTTP. Set true when the browser-facing URL is HTTPS.
SESSION_COOKIE_SECURE=false
# Public registration requires both this site key and TURNSTILE_SECRET_KEY in backend/.env.
DISABLE_PUBLIC_REGISTER=false
TURNSTILE_SITE_KEY=
# Number of trusted reverse proxies directly in front of the frontend.
FRONTEND_TRUST_PROXY_HOPS=0

# Conversion service
CONVERSION_SERVICE_URL=http://conversion:8004
# Scanned-page vision is BYOK: each user configures their own Google Gemini
# API key in the app's settings dialog. The server holds no vision key.
