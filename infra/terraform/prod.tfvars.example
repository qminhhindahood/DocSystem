project_id             = "your-gcp-project-id"
region                 = "asia-southeast1"
github_owner           = "your-github-owner"
github_repository      = "DocAI"
production_branch      = "master"
billing_account_id     = "01CC42-D509AB-1F4CB9"
image_tag              = "0123456789abcdef0123456789abcdef01234567"
notification_email     = "operator@example.com"
notification_channel_ids = []
operator_email         = "operator@example.com"
public_frontend_origin = "https://bootstrap.invalid"
public_frontend_fallback_origins = []
turnstile_site_key     = "replace-with-public-turnstile-site-key"

# Runtime secret values are deliberately absent. Add them with the bootstrap
# script/gcloud, then pin the resulting explicit versions here when rotating.
secret_versions = {
  jwt-secret                = "1"
  llm-config-encryption-key = "1"
  renderer-internal-token   = "1"
  redis-url                 = "1"
  jina-api-key              = "1"
  bootstrap-username        = "1"
  bootstrap-email           = "1"
  bootstrap-password        = "1"
  smoke-username            = "1"
  smoke-password            = "1"
  turnstile-secret-key      = "2"
}
