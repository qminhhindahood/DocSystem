{
  "name": "ai-document-system-backend",
  "version": "1.0.0",
  "description": "Backend API for the standalone DocAI PDF-to-DOCX conversion service",
  "main": "dist/index.js",
  "scripts": {
    "predev": "prisma migrate deploy",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:detect-baseline": "node dist/scripts/detect_migration_baseline.js",
    "deploy:migrate": "prisma migrate deploy",
    "deploy:bootstrap": "node dist/scripts/bootstrap_user.js",
    "deploy:reset-password": "node dist/scripts/reset_operator_password.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "check-schema": "node scripts/check_schema_sync.js",
    "test": "jest",
    "test:migrations": "jest scripts/check_migration_integrity.test.ts --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "redis": "^6.2.1",
    "uuid": "14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.15.2"
  }
}
