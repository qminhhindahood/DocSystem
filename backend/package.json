{
  "name": "ai-document-system-backend",
  "version": "1.0.0",
  "description": "Backend API for the standalone DocAI PDF-to-DOCX conversion service",
  "main": "dist/index.js",
  "scripts": {
    "predev": "prisma migrate deploy",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:detect-baseline": "node dist/scripts/detect_migration_baseline.js",
    "deploy:migrate": "prisma migrate deploy",
    "deploy:bootstrap": "node dist/scripts/bootstrap_user.js",
    "deploy:reset-password": "node dist/scripts/reset_operator_password.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "check-schema": "node scripts/check_schema_sync.js",
    "test": "jest",
    "test:migrations": "jest scripts/check_migration_integrity.test.ts --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.7.0",
    "redis": "^4.6.12",
    "uuid": "11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.15.2"
  }
}
