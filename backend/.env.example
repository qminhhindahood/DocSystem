# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_docs_target"

# LM Studio (local LLM)
# Authenticated users configure their own provider in Settings. These optional
# defaults are only for maintenance scripts that run without a user context.
# DEFAULT_LLM_PROVIDER="openrouter"
# DEFAULT_LLM_BASE_URL="https://openrouter.ai/api/v1"
# DEFAULT_LLM_MODEL="openrouter/free"
# DEFAULT_LLM_API_KEY=""

# Google Gemini alternative (OpenAI-compatible API)
# DEFAULT_LLM_PROVIDER="gemini"
# DEFAULT_LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# DEFAULT_LLM_MODEL="gemini-3.6-flash"
# DEFAULT_LLM_API_KEY="your-gemini-key"

# Redis (caching/job queue)
REDIS_URL="redis://localhost:6379"

# Python microservices
DOCLING_URL="http://localhost:8001"
EMBEDDINGS_URL="http://localhost:8002"
EMBEDDINGS_BATCH_TIMEOUT_MS=300000 # Increase for CPU-only local embedding models
DOCUMENT_RENDERER_URL="http://localhost:8080"
RENDERER_INTERNAL_TOKEN="replace-with-a-random-32-character-secret"
TEMPLATE_STORAGE_DIR="../../uploads/templates"
# The renderer uses LibreOffice, Poppler, and bundled free fonts. No license path is required.

# CORS — comma-separated list of allowed origins; default: http://localhost:3000
CORS_ORIGIN="http://localhost:3000"

# JWT secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="change-me-to-a-strong-jwt-secret-at-least-32-chars"

# Trust proxy — number of reverse-proxy hops (default: 0 when directly exposed)
TRUST_PROXY_HOPS=0

# Environment
NODE_ENV="development"

# Raw Prisma SQL is noisy because background workers poll while idle. Keep it
# disabled normally; enable only for a short local database-debugging session.
PRISMA_LOG_QUERIES="false"

# Security diagnostics (never enable in production)
ALLOW_STACK_TRACES="false" # Include stack traces in error responses

# Local LLM provider allowlist (comma-separated host:port entries)
# Only host:port pairs in this list may point at private/RFC1918 addresses.
# Required for lmstudio/ollama when running in Docker — set to:
#   host.docker.internal:1234
LOCAL_LLM_HOST_ALLOWLIST="host.docker.internal:1234"

# User LLM settings encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LLM_CONFIG_ENCRYPTION_KEY="your-64-char-hex-key-for-llm-config-encryption"

# OpenRouter models shown in the "Mô hình đề xuất" group, in display order.
# Set to an empty value to disable recommendations. Restart the backend after changes.
OPENROUTER_RECOMMENDED_MODELS="openrouter/free"

# Public registration (optional, default: enabled in dev, disabled in prod)
# Set to "true" to disable the POST /api/auth/register endpoint
DISABLE_PUBLIC_REGISTER="false"
TURNSTILE_SECRET_KEY="use-a-Cloudflare-test-secret-for-local-development"
TURNSTILE_EXPECTED_HOSTNAMES="localhost"

# Password recovery mail (required in production)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_FROM="DocAI <no-reply@example.com>"
# SMTP_USER and SMTP_PASS must either both be set or both be omitted.
SMTP_USER=""
SMTP_PASS=""
PASSWORD_RESET_BASE_URL="https://app.example.com/reset-password"

# ─── RAG quality-loop features (complex-RAG-guide port) ──────────────────────
# All OFF by default. Enable per-env after measuring the eval baseline.
#
# A: Query rewriter (offline synonym expansion + optional LLM rewrite)
ENABLE_QUERY_REWRITER="false"
# B/H: Per-document abstract (summary) chunks + always-on summary prepend
ENABLE_SUMMARY_CHUNKS="false"
# C: Post-retrieval relevancy filter (drops irrelevant chunks before the prompt)
ENABLE_RERANK_FILTER="false"
# E: Self-correcting retrieval/generation loop (bounded retries)
ENABLE_SELF_CORRECT="false"
RAG_MAX_RETRIES="1"
RAG_FAITHFULNESS_MIN="0.5"
RAG_ANSWERABILITY_MIN="0.3"
# Candidate generation / context packing / safe observability
RAG_RETRIEVAL_CANDIDATES="24"
RAG_MAX_QUERY_VARIANTS="3"
RAG_CONTEXT_MAX_CHARS="9000"
RAG_QUERY_EMBED_CACHE_TTL_SECONDS="300"
RAG_OBSERVABILITY="false"
RAG_RERANK_CHUNK_CHARS="1200"
RAG_RERANK_MAX_CHARS="16000"
# D: Eval script generation + faithfulness/answer-relevancy (LLM calls in eval)
EVAL_GENERATE="false"
EVAL_RESULTS_PATH=""
