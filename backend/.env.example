# Standalone conversion product — backend env contract.
# Copy to backend/.env (gitignored) and fill in real values.
#
# Required (validateEnv refuses to boot without these):
#   DATABASE_URL, REDIS_URL, JWT_SECRET, CONVERSION_SERVICE_URL

# Database (compose overrides this with the in-network Postgres URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_docs"

# Redis (queue + cache)
REDIS_URL="redis://localhost:6379"

# Conversion service (compose points this at http://conversion:8004)
CONVERSION_SERVICE_URL="http://localhost:8004"

# JWT secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="change-me-to-a-strong-jwt-secret-at-least-32-chars"

# CORS — comma-separated list of allowed origins; default: http://localhost:3000
CORS_ORIGIN="http://localhost:3000"

# Trust proxy — number of reverse-proxy hops (default: 0 when directly exposed)
TRUST_PROXY_HOPS=0

# Environment
NODE_ENV="development"

# Password recovery mode: "email" (SMTP) or "disabled".
# In production this MUST be set explicitly.
PASSWORD_RESET_MODE="email"

# Password recovery mail (required in production when PASSWORD_RESET_MODE=email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_FROM="Conversion Service <no-reply@example.com>"
# SMTP_USER and SMTP_PASS must either both be set or both be omitted.
SMTP_USER=""
SMTP_PASS=""
PASSWORD_RESET_BASE_URL="https://app.example.com/reset-password"

# Public registration (optional, default: enabled in dev, disabled in prod)
# Set to "true" to disable the POST /api/auth/register endpoint
DISABLE_PUBLIC_REGISTER="false"
# Turnstile is required in production when public registration is enabled
TURNSTILE_SECRET_KEY="use-a-Cloudflare-test-secret-for-local-development"
TURNSTILE_EXPECTED_HOSTNAMES="localhost"

# Security diagnostics (never enable in production)
ALLOW_STACK_TRACES="false" # Include stack traces in error responses

# Raw Prisma SQL is noisy because background workers poll while idle. Keep it
# disabled normally; enable only for a short local database-debugging session.
PRISMA_LOG_QUERIES="false"

# Optional tuning (all have safe defaults; see validateEnv.ts for bounds)
# PORT=3001
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# DB_CONNECTION_LIMIT=10
# SHUTDOWN_GRACE_MS=30000
# CONVERSION_TIMEOUT_MS=120000
