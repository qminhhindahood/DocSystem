// Standalone conversion product — auth + per-user vision provider config (ADR-0001).
// The master stack's eleven models were squashed to the three this product uses:
// the two auth models plus UserLLMConfig (BYOK vision provider settings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User accounts for multi-user support
model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String?  @unique
  passwordHash   String
  role           String   @default("user") // user, admin
  isDisabled     Boolean  @default(false)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resetTokens PasswordResetToken[]
  llmConfig   UserLLMConfig?

  @@index([username])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Per-user vision provider config (BYOK). The user brings their own API key;
// the server never provides one. Providers: openrouter | gemini. The key is
// stored AES-256-GCM encrypted (LLM_CONFIG_ENCRYPTION_KEY) and is only ever
// decrypted server-side to attach to a conversion job the user submits.
model UserLLMConfig {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        String // openrouter | gemini
  baseUrl         String
  model           String
  encryptedApiKey String @db.Text
  apiKeyIv        String @db.Text
  apiKeyAuthTag   String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
