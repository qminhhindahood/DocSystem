// This is your Prisma schema file, learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// Core document table
model Document {
  id                 String    @id @default(uuid())
  docType            String // Type: "cong-van", "quyet-dinh", "thong-tu", etc.
  docNumber          String? // Document number
  title              String
  content            String    @db.Text
  status             String    @default("draft") // draft, pending, approved, published
  ingestionStatus    String    @default("uploaded") // uploaded, parsing, chunking, embedding, indexed, failed
  processingError    String?   @db.Text
  processedAt        DateTime?
  chunkCount         Int       @default(0)
  embeddedChunkCount Int       @default(0)
  failedChunkCount   Int       @default(0)

  // Legal provenance/version fields. They remain optional because older corpus
  // imports do not always expose the information, but new ingestion can retain it.
  issuingAuthority String?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  repealedAt       DateTime?
  sourceVersion    String?
  metadata         Json?

  // File storage for async ingestion — populated on upload, consumed by background worker
  storageKey       String? // Relative path: uploads/<uuid>.pdf, resolved via UPLOAD_DIR
  originalFilename String?
  mimeType         String?
  fileSize         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?

  ownerId String @default("00000000-0000-0000-0000-000000000001")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  chunks       Chunk[]
  feedback     Feedback[]
  ingestionJob IngestionJob?

  @@index([docType])
  @@index([status])
  @@index([ingestionStatus])
  @@index([createdAt])
  @@index([ownerId])
}

// Durable PostgreSQL-backed queue for PDF ingestion. Workers claim jobs with a
// renewable lease so interrupted work can be recovered safely after restart.
model IngestionJob {
  id             String    @id @default(uuid())
  documentId     String    @unique
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status         String    @default("queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?   @db.Text
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

// Hierarchical chunks for RAG (3-level: Article -> Clause -> Point)
model Chunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  level   Int // 1=Article (Điều), 2=Clause (Khoản), 3=Point (Điểm)
  article String? // Article number (e.g., "Điều 1")
  clause  String? // Clause number (e.g., "Khoản 1.1")
  point   String? // Point number (e.g., "Điểm a")

  // Task B/H: abstract/summary chunks (level 0) for global-context recall.
  isSummary Boolean @default(false)
  summaryOf String? // "doc:<documentId>" or "article:<documentId>:<article>"

  content     String                       @db.Text
  contentHash String?
  pageNumber  Int?
  metadata    Json?
  embedding   Unsupported("vector(1024)")? // Jina Embeddings V5 (1024 dim) — use pgvector.toSql() for writes

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([level])
  @@index([contentHash])
}

// User feedback for self-learning
model Feedback {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  originalContent String @db.Text
  editedContent   String @db.Text
  diff            Json // JSON diff representation

  // Original fields
  editType   String? // addition, deletion, modification
  confidence Float? // Model confidence when generating

  // Enriched metadata from feedback analysis
  subType                  String? // formatting, wording, structural, legal, correction
  priority                 String? // critical, high, medium, low
  jaccardSimilarity        Float? // Jaccard text similarity
  affectsCompliance        Boolean   @default(false)
  classificationConfidence Float? // Classification confidence score
  approvedForTraining      Boolean   @default(false) // for LoRA
  approvedForRag           Boolean   @default(false) // for RAG augmentation
  reviewStatus             String    @default("pending") // pending/approved/rejected
  sessionId                String?
  modelName                String?
  reviewedAt               DateTime?

  // Extra context
  metadata Json?
  notes    String? // Review notes (admin/reviewer annotations)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([editType])
  @@index([priority])
  @@index([reviewStatus])
  @@index([approvedForTraining])
  @@index([approvedForRag])
  @@index([createdAt])
}

// LoRA Training Job tracking
model TrainingJob {
  id            String  @id @default(uuid())
  jobId         String  @unique // External job ID from lora-service
  status        String  @default("QUEUED") // M1: uppercase to match TrainingStatus enum
  threshold     Int     @default(50)
  sampleCount   Int     @default(0)
  filters       Json
  exportPath    String?
  outputPath    String?
  error         String? @db.Text
  // H13: per-job HMAC secret used to authenticate LoRA-service webhooks.
  // Generated at job creation; never returned to clients.
  webhookSecret String? @db.Text

  // Training progress (extended)
  progress       Int     @default(0) // 0-100 percentage
  epoch          Int     @default(0) // current epoch
  totalEpochs    Int     @default(10)
  currentLoss    Float?
  errorMessage   String? @db.Text
  feedbackIds    Json? // array of Feedback.id
  config         Json? // training hyperparams snapshot
  name           String?
  description    String?
  createdBy      String? // admin userId
  modelVersionId String?

  modelVersions ModelVersion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

// Model version tracking for fine-tuned models
//
// onDelete: SetNull on trainingJob is deliberate (m15). When a TrainingJob is
// cleaned up (cleanupOldJobs), its ModelVersion must NOT be cascade-deleted —
// the version may still be the active deployed model. The trade-off is that a
// ModelVersion with trainingJobId=null is an orphan. Periodic audit query:
// SELECT * FROM "ModelVersion" WHERE "trainingJobId" IS NULL AND status='candidate';
// can surface versions with no traceable provenance.
model ModelVersion {
  id                String       @id @default(uuid())
  baseModel         String
  adapterPath       String?
  modelPath         String? // Full path or remote URL to model artifacts
  version           String       @unique
  status            String       @default("candidate") // candidate, ready, active, deprecated, failed
  isActivated       Boolean      @default(false)
  trainingJobId     String?
  trainingJob       TrainingJob? @relation(fields: [trainingJobId], references: [id], onDelete: SetNull)
  feedbackCount     Int          @default(0)
  metrics           Json?
  lmStudioModelName String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  activatedAt       DateTime?
  activatedBy       String?

  @@index([status])
  @@index([isActivated])
  @@index([createdAt])
  @@index([trainingJobId])
}

enum TemplateStatus {
  UPLOADED
  ANALYZING
  NEEDS_REVIEW
  READY
  REJECTED
  FAILED
}

model Template {
  id                  String         @id @default(uuid())
  ownerId             String         @default("00000000-0000-0000-0000-000000000001")
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name                String
  docType             String?
  header              String         @default("")
  signatureBlock      String         @default("")
  description         String?
  originalPath        String?
  originalSha256      String?
  fileSize            Int            @default(0)
  status              TemplateStatus @default(REJECTED)
  semanticMap         Json?
  generationSchema    Json?
  analysisConfidence  Float?
  compatibilityReport Json?
  previewMetadata     Json?
  rejectionCode       String?
  rejectionReason     String?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
  @@index([isActive])
}

model UserDocumentProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisingAgency    String?
  agencyName           String?
  agencyCode           String?
  agencyAddress        String?
  agencyEmail          String?
  agencyWebsite        String?
  agencyPhone          String?
  defaultPlace         String?
  defaultRecipients    Json?
  signatoryName        String?
  signatoryTitle       String?
  documentNumberPrefix String?
  nextDocumentNumber   Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// User accounts for multi-user support
model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String?  @unique
  passwordHash   String
  role           String   @default("user") // user, admin
  isDisabled     Boolean  @default(false)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  llmConfig       UserLLMConfig?
  documents       Document[]
  templates       Template[]
  documentProfile UserDocumentProfile?
  resetTokens     PasswordResetToken[]

  @@index([username])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Per-user LLM provider configuration (encrypted API keys)
model UserLLMConfig {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        String // openai, openrouter, gemini, lmstudio, ollama, custom
  baseUrl         String
  model           String
  encryptedApiKey String @db.Text
  apiKeyIv        String @db.Text
  apiKeyAuthTag   String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
