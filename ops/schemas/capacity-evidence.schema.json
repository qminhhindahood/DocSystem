{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docai.local/schemas/capacity-evidence.schema.json",
  "title": "CapacityEvidenceV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseSha", "mode", "status", "zeroCostFeasible",
    "createdAt", "validUntil", "records"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "mode": { "enum": ["preflight_projection", "runtime_actual"] },
    "status": { "enum": ["passed", "blocked"] },
    "zeroCostFeasible": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric", "policy", "measuredValue", "unit", "internalCeiling",
          "officialAllowance", "ratio", "zeroCostStatus", "approvedException",
          "accountIdentityHash", "source",
          "observedAt", "validUntil", "releaseId", "safeCollectionError", "status"
        ],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "policy": { "enum": ["progressive", "hard_limit"] },
          "measuredValue": { "type": ["number", "null"], "minimum": 0 },
          "unit": { "type": "string", "minLength": 1 },
          "internalCeiling": { "type": "number", "exclusiveMinimum": 0 },
          "officialAllowance": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "ratio": { "type": ["number", "null"], "minimum": 0 },
          "zeroCostStatus": { "enum": ["passed", "blocked"] },
          "approvedException": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind", "estimatedMonthlyCostUsd", "approvedMonthlyCapUsd",
                  "pricingSourceSha256"
                ],
                "properties": {
                  "kind": { "const": "artifact_registry_recurring_cost_cap" },
                  "estimatedMonthlyCostUsd": { "type": "number", "exclusiveMinimum": 0 },
                  "approvedMonthlyCapUsd": { "type": "number", "exclusiveMinimum": 0 },
                  "pricingSourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            ]
          },
          "accountIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "validUntil": { "type": "string", "format": "date-time" },
          "releaseId": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "safeCollectionError": { "type": ["string", "null"], "minLength": 1 },
          "status": { "enum": ["passed", "blocked"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
            "then": {
              "properties": {
                "measuredValue": { "type": "number", "minimum": 0 },
                "safeCollectionError": { "type": "null" }
              },
              "oneOf": [
                {
                  "properties": {
                    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
                    "zeroCostStatus": { "const": "passed" },
                    "approvedException": { "type": "null" }
                  }
                },
                {
                  "properties": {
                    "metric": { "const": "artifactRegistryBytes" },
                    "policy": { "const": "hard_limit" },
                    "ratio": { "type": "number", "exclusiveMinimum": 1 },
                    "zeroCostStatus": { "const": "blocked" },
                    "approvedException": { "type": "object" }
                  }
                }
              ]
            }
          },
          {
            "if": { "properties": { "measuredValue": { "type": "null" } }, "required": ["measuredValue"] },
            "then": {
              "properties": {
                "status": { "const": "blocked" },
                "safeCollectionError": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "records": {
            "items": { "properties": { "status": { "const": "passed" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "zeroCostFeasible": { "const": true } },
        "required": ["zeroCostFeasible"]
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "properties": {
                "zeroCostStatus": { "const": "passed" },
                "approvedException": { "type": "null" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "passed" },
          "zeroCostFeasible": { "const": false }
        },
        "required": ["status", "zeroCostFeasible"]
      },
      "then": {
        "properties": {
          "records": {
            "contains": {
              "properties": {
                "metric": { "const": "artifactRegistryBytes" },
                "zeroCostStatus": { "const": "blocked" },
                "approvedException": { "type": "object" }
              },
              "required": ["metric", "zeroCostStatus", "approvedException"]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ]
}
