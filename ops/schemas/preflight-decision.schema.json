{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docai.local/schemas/preflight-decision.schema.json",
  "title": "PreflightDecisionV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseSha", "createdAt", "decision", "selectedNeonRegion",
    "embeddingFeasible", "migrationCostUsd", "nonZeroCostApproved", "recurringCostUsd",
    "recurringCostApproved", "approvedRecurringCostCapUsd", "zeroCostFeasible", "capacityEvidence",
    "checks", "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["GO", "NO_GO"] },
    "selectedNeonRegion": { "type": "string", "minLength": 1 },
    "embeddingFeasible": { "type": "boolean" },
    "migrationCostUsd": { "type": ["number", "null"], "minimum": 0 },
    "nonZeroCostApproved": { "type": "boolean" },
    "recurringCostUsd": { "type": ["number", "null"], "minimum": 0 },
    "recurringCostApproved": { "type": "boolean" },
    "approvedRecurringCostCapUsd": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "zeroCostFeasible": { "type": "boolean" },
    "capacityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.artifacts/releases/[A-Za-z0-9._/-]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "blocked"] },
          "reason": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^\\.artifacts/releases/[A-Za-z0-9._/-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "GO" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "embeddingFeasible": { "const": true },
          "recurringCostUsd": { "type": "number", "minimum": 0 }
        }
      }
    },
    {
      "if": { "properties": { "zeroCostFeasible": { "const": true } }, "required": ["zeroCostFeasible"] },
      "then": {
        "properties": {
          "recurringCostUsd": { "const": 0 },
          "recurringCostApproved": { "const": false },
          "approvedRecurringCostCapUsd": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "recurringCostApproved": { "const": true } }, "required": ["recurringCostApproved"] },
      "then": {
        "properties": {
          "recurringCostUsd": { "type": "number", "exclusiveMinimum": 0 },
          "approvedRecurringCostCapUsd": { "type": "number", "exclusiveMinimum": 0 },
          "zeroCostFeasible": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": { "const": "GO" },
          "zeroCostFeasible": { "const": false }
        },
        "required": ["decision", "zeroCostFeasible"]
      },
      "then": { "properties": { "recurringCostApproved": { "const": true } } }
    }
  ]
}
