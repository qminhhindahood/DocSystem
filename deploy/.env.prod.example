# Copy to deploy/.env.prod, run deploy/generate-secrets.sh, then fill every
# remaining blank value. Never commit deploy/.env.prod.

# Public DNS and Let's Encrypt account
DOMAIN=
LETSENCRYPT_EMAIL=
CORS_ORIGIN=

# Users configure their own encrypted LLM provider, model, and API key in the
# application. This operator setting only controls model recommendations.
OPENROUTER_RECOMMENDED_MODELS=openrouter/free

# Jina Cloud embeddings proxy
JINA_API_KEY=

# Managed PostgreSQL with pgvector available. The deployment role must be able
# to CREATE EXTENSION vector when it has not already been enabled.
DB_URL=

# Optional managed Redis override; omit to use the Compose Redis service.
# REDIS_URL=rediss://user:password@redis.example.com:6379

# Generated by deploy/generate-secrets.sh
RENDERER_INTERNAL_TOKEN=
JWT_SECRET=
LLM_CONFIG_ENCRYPTION_KEY=

# Renderer limits
RENDERER_RENDER_TIMEOUT_SECONDS=120
RENDERER_MAX_CONCURRENT_RENDERS=2
RENDERER_PNG_DPI=144
RENDERER_MAX_RENDERED_PAGES=100
RENDERER_MAX_RENDERED_BYTES=268435456
